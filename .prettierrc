{
  "plugins": ["@shufo/prettier-plugin-blade"],
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "overrides": [
    {
      "files": ["*.blade.php"],
      "options": {
        "parser": "blade",
        "bladeWrapAttributes": "auto",
        "wrapAttributesMinAttrs": 2,
        "sortTailwindcssClasses": true
      }
    }
  ]
}
